#!/bin/sh
# pre-push: never update master, and name branches feat|fix/issue-<n>-<slug>.
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/master)
            echo "pre-push: pushing to master is blocked. The owner merges pull requests." >&2
            status=1
            ;;
        refs/heads/*)
            [ "$local_sha" = "$zero" ] && continue
            branch=${remote_ref#refs/heads/}
            if ! printf '%s\n' "$branch" | grep -Eq '^(feat|fix)/issue-[0-9]+-[a-z0-9-]+$'; then
                echo "pre-push: branch '$branch' must be named feat|fix/issue-<n>-<slug> (lowercase letters, digits, hyphens)." >&2
                status=1
            fi
            ;;
    esac
done
exit $status
