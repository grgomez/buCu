#!/bin/sh
# pre-commit: clang-format check on the staged C++ files (constitution section 3).
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$')
[ -z "$files" ] && exit 0

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: C++ files are staged but clang-format is not installed." >&2
    exit 1
fi

status=0
while IFS= read -r file; do
    if ! git show ":$file" | clang-format --assume-filename="$file" --dry-run --Werror >/dev/null 2>&1; then
        echo "pre-commit: $file is not formatted. Run scripts/format.sh and stage it again." >&2
        status=1
    fi
done <<LIST
$files
LIST
exit $status
